{
  "annotations": {"list": []},
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "schemaVersion": 39,
  "tags": ["baba", "lstm", "ml"],
  "templating": {"list": []},
  "time": {"from": "now-30m", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "BABA Overview",
  "uid": "baba-overview",
  "version": 1,
  "refresh": "15s",
  "panels": [
    {
      "type": "row",
      "id": 100,
      "title": "Service health",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate by route",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 1},
      "datasource": {"type": "prometheus", "uid": "baba-prometheus"},
      "targets": [
        {"expr": "sum by (handler) (rate(http_requests_total{job=\"baba-api\"}[1m]))",
         "legendFormat": "{{handler}}", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "options": {"legend": {"showLegend": true}}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Error rate (5xx, last 5 min)",
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 1},
      "datasource": {"type": "prometheus", "uid": "baba-prometheus"},
      "targets": [
        {"expr": "100 * sum(rate(http_requests_total{job=\"baba-api\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total{job=\"baba-api\"}[5m])), 1)",
         "refId": "A"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "yellow", "value": 1},
            {"color": "red", "value": 5}
          ]}
        },
        "overrides": []
      },
      "options": {"colorMode": "background", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Model loaded",
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 1},
      "datasource": {"type": "prometheus", "uid": "baba-prometheus"},
      "targets": [{"expr": "baba_model_loaded", "refId": "A"}],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"options": {"0": {"text": "NO", "color": "red"}}, "type": "value"},
            {"options": {"1": {"text": "YES", "color": "green"}}, "type": "value"}
          ],
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "red", "value": null},
            {"color": "green", "value": 1}
          ]}
        },
        "overrides": []
      },
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "HTTP latency p50 / p95 / p99 (all routes)",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 9},
      "datasource": {"type": "prometheus", "uid": "baba-prometheus"},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"baba-api\"}[5m])))",
         "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"baba-api\"}[5m])))",
         "legendFormat": "p95", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"baba-api\"}[5m])))",
         "legendFormat": "p99", "refId": "C"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },
    {
      "type": "row",
      "id": 101,
      "title": "Model serving",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 17},
      "collapsed": false,
      "panels": []
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Predictions per minute (by endpoint)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 18},
      "datasource": {"type": "prometheus", "uid": "baba-prometheus"},
      "targets": [
        {"expr": "60 * sum by (endpoint) (rate(baba_predictions_total[1m]))",
         "legendFormat": "{{endpoint}}", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Pure inference p95 (by endpoint)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 18},
      "datasource": {"type": "prometheus", "uid": "baba-prometheus"},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum by (le, endpoint) (rate(baba_inference_duration_seconds_bucket[5m])))",
         "legendFormat": "{{endpoint}}", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },
    {
      "id": 7,
      "type": "heatmap",
      "title": "Predicted close — distribution (USD)",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 26},
      "datasource": {"type": "prometheus", "uid": "baba-prometheus"},
      "targets": [
        {"expr": "sum by (le) (rate(baba_predicted_close_usd_bucket[5m]))",
         "format": "heatmap", "legendFormat": "{{le}}", "refId": "A"}
      ],
      "options": {"yAxis": {"unit": "currencyUSD"}, "color": {"mode": "scheme", "scheme": "Spectral"}}
    },
    {
      "type": "row",
      "id": 102,
      "title": "Input drift",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 34},
      "collapsed": false,
      "panels": []
    },
    {
      "id": 8,
      "type": "heatmap",
      "title": "Input window MEAN (USD)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 35},
      "datasource": {"type": "prometheus", "uid": "baba-prometheus"},
      "targets": [
        {"expr": "sum by (le) (rate(baba_input_window_mean_usd_bucket[5m]))",
         "format": "heatmap", "legendFormat": "{{le}}", "refId": "A"}
      ],
      "options": {"yAxis": {"unit": "currencyUSD"}, "color": {"mode": "scheme", "scheme": "Spectral"}}
    },
    {
      "id": 9,
      "type": "heatmap",
      "title": "Input window STD (USD)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 35},
      "datasource": {"type": "prometheus", "uid": "baba-prometheus"},
      "targets": [
        {"expr": "sum by (le) (rate(baba_input_window_std_usd_bucket[5m]))",
         "format": "heatmap", "legendFormat": "{{le}}", "refId": "A"}
      ],
      "options": {"yAxis": {"unit": "currencyUSD"}, "color": {"mode": "scheme", "scheme": "Spectral"}}
    },
    {
      "type": "row",
      "id": 103,
      "title": "Training observability",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 43},
      "collapsed": false,
      "panels": []
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Time since last training",
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 44},
      "datasource": {"type": "prometheus", "uid": "baba-prometheus"},
      "targets": [
        {"expr": "time() - baba_last_train_timestamp_seconds", "refId": "A"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "yellow", "value": 86400},
            {"color": "red", "value": 604800}
          ]}
        },
        "overrides": []
      },
      "options": {"colorMode": "background", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 11,
      "type": "bargauge",
      "title": "Last training test metrics",
      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 44},
      "datasource": {"type": "prometheus", "uid": "baba-prometheus"},
      "targets": [
        {"expr": "baba_last_train_metric", "legendFormat": "{{metric}}", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"displayMode": "lcd", "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Total training runs",
      "gridPos": {"h": 6, "w": 8, "x": 16, "y": 44},
      "datasource": {"type": "prometheus", "uid": "baba-prometheus"},
      "targets": [{"expr": "baba_train_runs_total", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"]}}
    }
  ]
}
